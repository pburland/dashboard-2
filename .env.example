# Copy names into Railway → Variables. Never put real values in this file or the repo.

# ── Required ─────────────────────────────────────────────────────────────
# Postgres connection string from Supabase → Project Settings → Database.
SUPABASE_DB_URL=
# A long random string you generate. Protects /admin/* until login exists.
ADMIN_TOKEN=
ANTHROPIC_API_KEY=

# ── Integrations ─────────────────────────────────────────────────────────
# Contents of ~/garmin-login/garmin_tokens.json. Bootstrap only: renewed
# tokens are saved to the database, which takes precedence afterwards.
GARMIN_TOKENS=
HEVY_API_KEY=
# From your Oura application at cloud.ouraring.com.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Google Calendar → Settings → your calendar → "Secret address in iCal format".
# Only busy times are read; event titles are never stored or sent anywhere.
GOOGLE_CALENDAR_ICS_URL=

# ── Later phases ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Settings (not secret; defaults shown) ───────────────────────────────
TZ_NAME=America/New_York
HOME_LAT=38.8816
HOME_LNG=-77.0910
# Public base URL of this service, e.g. https://<name>.up.railway.app
PUBLIC_BASE_URL=
OURA_SCOPES=personal daily heartrate session
# Empty = the newest Sonnet model your API key can use.
ANTHROPIC_MODEL=
# Background jobs (nightly 03:00, morning 05:30, Sunday 7 PM weekly report, one-time backfill). "off" disables.
SCHEDULER=on
